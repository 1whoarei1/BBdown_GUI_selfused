{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BBDown Next",
  "version": "0.1.0",
  "identifier": "com.bbdown.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BBDown Next",
        "width": 1180,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
